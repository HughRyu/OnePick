# Copy to .env and replace all placeholder values.
ONEPICK_AUTH_USER=admin
ONEPICK_AUTH_PASSWORD=change-me
ONEPICK_AUTH_SECRET=generate-a-long-random-secret
ONEPICK_API_TOKEN=generate-a-long-random-token
ONEPICK_TOKEN_TTL_SECONDS=2592000

# Optional outbound proxy settings.
NODE_USE_ENV_PROXY=0
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1